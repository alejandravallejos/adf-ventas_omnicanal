{
	"name": "df_repartidores",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "repartidores_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "repartidores_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(repartidor_id = toString(trim(repartidor_id)),",
				"          nombre_repartidor = toString(trim(nombre_repartidor)),",
				"          tipo_vehiculo = coalesce(toString(trim(tipo_vehiculo)), 'Motocicleta'),",
				"          activo = coalesce(toString(trim(activo)), 'Activo')) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(repartidor_id) && !isNull(nombre_repartidor) && !isNull(ciudad_base) && !isNull(activo) && activo != 'No',",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          repartidor_id as string,",
				"          nombre as string,",
				"          telefono as string,",
				"          vehiculo as string,",
				"          ciudad_base as string,",
				"          estado as string,",
				"          fecha_registro as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          repartidor_id,",
				"          nombre = nombre_repartidor,",
				"          vehiculo = tipo_vehiculo,",
				"          estado = activo,",
				"          fecha_registro = fecha_alta,",
				"          ciudad_base",
				"     )) ~> sink1"
			]
		}
	}
}