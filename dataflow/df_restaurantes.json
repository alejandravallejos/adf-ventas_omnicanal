{
	"name": "df_restaurantes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "restaurantes_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "restaurantes_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          restaurante_id as string,",
				"          nombre_restaurante as string,",
				"          tipo_cocina as string,",
				"          calificacion_promedio as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(restaurante_id = toString(trim(restaurante_id)),",
				"          nombre_restaurante = toString(trim(nombre_restaurante)),",
				"          tipo_cocina = coalesce(toString(trim(tipo_cocina)), 'General'),",
				"          calificacion_promedio = toDecimal(calificacion_promedio, 3, 2)) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(restaurante_id) && !isNull(nombre_restaurante) && !isNull(activo)&& activo != 'No' && (isNull(calificacion_promedio) || (toDecimal(calificacion_promedio, 3, 2) >= 0.00 && toDecimal(calificacion_promedio, 3, 2) <= 5.00)),",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          restaurante_id as string,",
				"          nombre as string,",
				"          ciudad as string,",
				"          categoria as string,",
				"          calificacion as decimal(3,2),",
				"          estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          restaurante_id,",
				"          nombre = nombre_restaurante,",
				"          categoria = tipo_cocina,",
				"          calificacion = calificacion_promedio,",
				"          estado = activo",
				"     )) ~> sink1"
			]
		}
	}
}