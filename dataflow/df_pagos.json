{
	"name": "df_pagos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "pagos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "pagos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "split1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          pago_id as string,",
				"          pedido_id as string,",
				"          fecha_pago as string,",
				"          metodo_pago as string,",
				"          estado_pago as string,",
				"          monto_pagado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(pago_id = toString(trim(pago_id)),",
				"          pedido_id = toString(trim(pedido_id)),",
				"          metodo_pago = toString(trim(metodo_pago)),",
				"          monto_pagado = coalesce(toDecimal(monto_pagado, 12, 2), toDecimal(0, 12, 2)),",
				"          estado_pago = coalesce(toString(trim(estado_pago)), 'Completado')) ~> derivedColumn1",
				"derivedColumn1 split(!isNull(pago_id) && !isNull(pedido_id) && !isNull(fecha_pago) && coalesce(toDecimal(monto_pagado, 12, 2), toDecimal(0, 12, 2)) > 0,",
				"     disjoint: false) ~> split1@(validos, rechazados)",
				"split1@validos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          pago_id as string,",
				"          pedido_id as string,",
				"          metodo_pago as string,",
				"          monto_pago as decimal(12,2),",
				"          fecha_pago as string,",
				"          estado_pago as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          pago_id,",
				"          pedido_id,",
				"          metodo_pago,",
				"          monto_pago = monto_pagado,",
				"          fecha_pago,",
				"          estado_pago",
				"     )) ~> sink1"
			]
		}
	}
}